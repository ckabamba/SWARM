# Server-side settings for /etc/warmpath/warmpath.env (owner root, group warmpath, mode 0640).
# The real file is written on the server at deploy time and is never committed.

# Restricted runtime role, TLS with hostname verification against the RDS CA bundle.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://warmpath_app:<password>@<rds-endpoint>:5432/warmpath?sslmode=verify-full&sslrootcert=/etc/warmpath/rds-ca.pem

# The exact public HTTPS origin (the CloudFront domain). Enables Secure cookies,
# the allowed Host and the same-origin check for writes.
WARMPATH_PUBLIC_ORIGIN=https://<distribution-id>.cloudfront.net

# The API listens on loopback only; nginx is the only client.
WARMPATH_HOST=127.0.0.1
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
