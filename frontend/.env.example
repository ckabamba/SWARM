# Copy to frontend/.env (ignored by git). Restart `npm run dev` after changing it.

# Where the app's data comes from:
#   fixture  (default) everything comes from the in-repo fixtures; no backend needed
#   api      Social Jackets posts and events come from the FastAPI backend through the /api dev proxy
# In api mode a failed call shows a "could not be loaded" note, never fixture data.
# A hosted build must use api: run `VITE_DATA_SOURCE=api npm run build`.
VITE_DATA_SOURCE=fixture
