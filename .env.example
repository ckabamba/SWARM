# Copy this file to .env and fill it in. .env is ignored by git.
# Never commit real passwords or keys.

# Database that migrations and the backend connect to.
# Local database started from backend/engine/docker-compose.yml:
DATABASE_URL=postgresql://warmpath:warmpath@localhost:5432/warmpath

# Shared AWS RDS database. Get the endpoint and password from the data owner.
# Percent-encode special characters in the password (for example # becomes %23).
# DATABASE_URL=postgresql://warmpath:<password>@<rds-endpoint>:5432/warmpath?sslmode=require

# Only for a deployed service behind HTTPS, not needed for local development.
# Configure this on the server, never in a browser or a VITE_ variable.
# WARMPATH_PUBLIC_ORIGIN=https://app.example.edu
# WARMPATH_HOST=0.0.0.0
# PORT=8000

# Tests require a separate database named warmpath_test (create it first).
# TEST_DATABASE_URL=postgresql://warmpath:warmpath@localhost:5432/warmpath_test

# Explicit local-only synthetic histories; disabled by default. Never use for deployment.
# WARMPATH_DEMO_HISTORIES=1
